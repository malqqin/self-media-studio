# 只绑定本机；在其他设备或公网部署前先增加认证、TLS 和访问控制。
STUDIO_DATA_DIR=./data
# 留空可采集资料；AI 推荐和制作需在页面配置模型。
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
# 成片固定 10 秒、无音轨，不需要语音服务。
# 可选覆盖；默认使用 imageio-ffmpeg 随包安装的 FFmpeg。
FFMPEG_PATH=
FONT_PATH=
# 浏览器采集优先使用已安装的 Edge/Chrome；也可指定浏览器完整路径。
STUDIO_BROWSER_PATH=
