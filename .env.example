# 数据库统一使用 PostgreSQL 15+。必须是普通角色，不能是 superuser / BYPASSRLS。
# 数据库应单独创建并由此角色拥有；密码请使用 URL 编码。
DATABASE_URL=postgresql://studio_app:CHANGE_ME@127.0.0.1:5432/studio
DATABASE_SCHEMA=studio
# 独立测试数据库，禁止指向运行数据库。
TEST_DATABASE_URL=postgresql://studio_app:CHANGE_ME@127.0.0.1:5432/studio_test
# 本地默认只允许本机；部署时改为真实域名、HTTPS Origin，并启用安全 Cookie。
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765,http://127.0.0.1:5173,http://localhost:5173
COOKIE_SECURE=false
STUDIO_DATA_DIR=./data
# 环境模型仅归初始管理员所有；其他用户在“我的模型”单独配置。
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
# 成片固定 10 秒、无音轨，不需要语音服务。
# 可选覆盖；默认使用 imageio-ffmpeg 随包安装的 FFmpeg。
FFMPEG_PATH=
FONT_PATH=
# 浏览器采集优先使用已安装的 Edge/Chrome；也可指定浏览器完整路径。
STUDIO_BROWSER_PATH=
